default: dev

dev:
    cargo run

build:
    RUSTFLAGS="-C target-cpu=native" cargo build --release

# Fast unit tests. No live services required.
test:
    cargo test

test-cov:
    cargo llvm-cov --html --summary-only || cargo test

# Tests that need live Postgres (ignored by default; run with --ignored).
test-integration:
    cargo test -- --ignored --nocapture
