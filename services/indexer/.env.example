# Indexer Service - Environment Configuration
# (from services/indexer/src/core/config.rs)
#
# Note: dotenv only strips an inline comment when whitespace precedes the '#'.
#       Keep at least one space before every comment or it becomes part of the
#       value and numeric parsing panics at startup.

# ===== Database - REQUIRED =====
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://admin:1234@psql:5432/se

# Database Connection Pooling
# PG_MAX_CONNECTIONS also sets max_concurrent_tasks and the AMQP prefetch
PG_MAX_CONNECTIONS=10          # Max pool connections
PG_MIN_CONNECTIONS=2           # Min pool connections
ACQUIRE_TIMEOUT_SECONDS=5      # Connection acquire timeout

# Server-side timeouts, sent as startup params on every pooled connection.
# Without these a lock wait is unbounded and a worker task can hang forever.
PG_LOCK_TIMEOUT_MS=5000        # Abort a statement that waits on a lock for >5s
PG_STATEMENT_TIMEOUT_MS=60000  # Abort any single statement running >60s

# Database Batch Sizes
WORD_BATCH_SIZE=1000           # Words insert batch size
PAGE_WORD_BATCH_SIZE=500       # Page-word insert batch size
MAX_RETRIES=3                  # Retries per batch operation

# ===== RabbitMQ - RABBITMQ_URL is REQUIRED (startup panics without it) =====
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# Queue of crawl jobs. Must match what services/spider publishes to.
# Both sides must declare it durable or the broker rejects with 406.
RABBITMQ_QUEUE=indexer.jobs

# Queue receiving index confirmations. Must be declared durable by whichever
# service consumes it. The indexer never declares it, and with mandatory:true
# publishing to a missing queue returns a routing error.
RABBITMQ_CONFIRMATION_QUEUE=indexer.confirmations

# ===== Reconciliation Sweep =====
# How often to re-scan for pages that were never indexed
SWEEP_INTERVAL_SECONDS=300
# Ignore pages updated within this window, so in-flight pages aren't double-queued
SWEEP_GRACE_SECONDS=600

# ===== Logging =====
LOG_PATH=./logs/indexer.log    # Log file location
