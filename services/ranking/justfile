venv := "venv"
python := "venv/bin/python"
pip := "venv/bin/pip"

default: run

venv:
    python3 -m venv {{venv}}

# Install dependencies
install: venv
    {{pip}} install --upgrade pip
    {{pip}} install -r requirements.txt

run:
    {{python}} src/main.py

build: install
    pyinstaller --onefile src/main.py

# Fast unit tests. No infrastructure required.
test:
    {{python}} -m pytest tests -m "not integration"

test-cov:
    {{python}} -m pytest tests -m "not integration" --cov=src --cov-report=term-missing

# Tests that need a live PostgreSQL. Creates and migrates an isolated
# `boogle_test` database first -- never the live `boogle` one, because these
# tests write scores.
test-integration:
    bash {{justfile_directory()}}/../../scripts/setup-test-db.sh
    {{python}} -m pytest tests -m integration

clean:
    rm -rf {{venv}} __pycache__ src/__pycache__  dist
