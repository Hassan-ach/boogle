# Ranking Service - Environment Configuration

# ===== PostgreSQL Database Configuration =====
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=se
PG_USER=admin
PG_PASSWORD=1234

# Optional Full Database URL override
# DATABASE_URL=postgresql://admin:1234@localhost:5432/se

# ===== RabbitMQ Broker Configuration =====
# RabbitMQ Connection URL (use 'localhost' for host execution, 'rabbitmq' for Docker execution)
BROKER_URL=amqp://admin:admin@localhost:5672
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# Queue receiving index confirmations from indexer service
RABBITMQ_CONFIRMATION_QUEUE=indexer.confirmations
