# Ranking Service - Environment Configuration

# ===== PostgreSQL Database Configuration =====
# Inside Docker the host is the compose service name. Use `localhost` when the
# service runs directly on the host.
PG_HOST=psql
PG_PORT=5432
PG_DBNAME=se
PG_USER=admin
PG_PASSWORD=change-me-postgres

# Optional Full Database URL override (wins over PG_*)
# DATABASE_URL=postgresql://admin:change-me-postgres@psql:5432/se

# ===== RabbitMQ Broker Configuration =====
# Either URL is enough. `rabbitmq` is the compose service name; use `localhost`
# for host execution.
BROKER_URL=amqp://admin:change-me-rabbitmq@rabbitmq:5672
# RABBITMQ_URL=amqp://admin:change-me-rabbitmq@rabbitmq:5672

# Queue receiving index confirmations from indexer service
RABBITMQ_CONFIRMATION_QUEUE=indexer.confirmations

# ===== Ranking Behaviour =====
# Confirmations to accumulate before recomputing IDF and PageRank
RANKING_CONFIRMATION_THRESHOLD=100
# Score whatever is already indexed at startup, so a small corpus is searchable
RANKING_RUN_ON_STARTUP=true

# ===== Logging =====
# Logs always go to stdout. Set this only to also write a file (the path must be
# writable by uid 10001 in the container).
# LOG_PATH=/app/logs/ranking.log
