# Spider Service - Environment Configuration
# (from services/spider/internal/config/config.go)

# ===== Database Configuration =====
PG_HOST=psql
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=change-me-postgres
PG_DBNAME=se

# Database Connection Pooling
PG_MAX_OPEN_CONNS=20
PG_MAX_IDLE_CONNS=20
PG_MAX_CONN_LIFETIME=0        # seconds, 0 = unlimited
PG_BATCH_SIZE=30               # Batch size for DB writes

# ===== Redis Cache Configuration =====
REDIS_ADDR=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis  # Must match REDIS_PASSWORD in the root .env
REDIS_DB=1                     # Database number
REDIS_DELAY=5                  # Delay in seconds
REDIS_MAX_RETRY=10             # Max retries on failure

# ===== RabbitMQ (REQUIRED: the entrypoint refuses to start without these) =====
RABBITMQ_PROTOCOL=amqp
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Must match the indexer's RABBITMQ_QUEUE. Both sides default to indexer.jobs.
RABBITMQ_QUEUE=indexer.jobs

# ===== Crawler Configuration =====
MAX_CRAWLERS=20                # Number of concurrent crawlers
MAX_CONCURRENT_FETCH=200       # HTTP requests in parallel
HTTP_TIMEOUT=60                # Per-request timeout (seconds)
CRAWLER_TIMEOUT=60             # Overall crawl session timeout
CRAWLER_DELAY=200              # Delay between requests (milliseconds)
LOGS_PATH=./logs.json          # Log file location

# ===== Policy / crawl limits =====
MAX_PAGES_PER_HOST=5000
URL_MAX_ATTEMPTS=3
MAX_REDIRECTS=10
MAX_BODY_BYTES=10485760        # 10 MiB
FRONTIER_POP_BATCH=16
DELAYED_PROMOTE_BATCH=100
SPIDER_REDIS_PREFIX=boogle:spider
