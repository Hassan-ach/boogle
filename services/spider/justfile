default: dev

# Variables
VERSION := "1.0.0"
BUILDTIME := `date -u '+%Y-%m-%d_%H:%M:%S'`
BIN := "spider"
ENTRY := "./cmd/spider/main.go"

# Flags
LDFLAGS := "-s -w -X main.Version={{VERSION}} -X main.BuildTime={{BUILDTIME}}"
GCFLAGS := "all=-B"

dev:
    go run {{ENTRY}}

build:
    go build -ldflags="{{LDFLAGS}}" -gcflags="{{GCFLAGS}}" -o {{BIN}} {{ENTRY}}

run: build
    ./{{BIN}}

lint:
    golangci-lint run ./...

# Fast unit tests. No infrastructure required.
test:
    go test ./internal/... -count=1

test-cov:
    go test ./internal/... -count=1 -coverprofile=coverage.out
    go tool cover -func=coverage.out

# Tests that need live Postgres/Redis/RabbitMQ (build tag: integration).
test-integration:
    go test -tags integration ./internal/... -count=1
