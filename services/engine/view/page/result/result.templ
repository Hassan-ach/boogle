package result

import "github.com/Hassan-ach/boogle/services/engine/internal/model"
import "github.com/Hassan-ach/boogle/services/engine/view/layout"
import "github.com/Hassan-ach/boogle/services/engine/view/component"
import "github.com/Hassan-ach/boogle/services/engine/view/page/result/tab"

// ShowAll renders the search results.
//
// #results is the htmx swap target, so the full page renders it once and the
// partial response renders only its inner content. Pagination lives inside it,
// which is what keeps page navigation inside the swapped region.
templ ShowAll(pages []*model.Page, totalResults int, totalPages int, currentPage int, isHtmx bool) {
    if isHtmx {
        @tab.All(pages, totalResults, totalPages, currentPage)
    } else {
        @layout.Base() {
            <div class="page-wrapper">
                @component.ResultHeader()
                <div id="results" class="content-container py-6">
                    @tab.All(pages, totalResults, totalPages, currentPage)
                </div>
            </div>
        }
    }
}

templ ShowGraph(result any, isHtmx bool) {
    if isHtmx {
        @tab.Graph()
    } else {
        @layout.Base() {
            <div class="page-wrapper">
                @component.ResultHeader()
                <div id="results" class="content-container py-6">
                    @tab.Graph()
                </div>
            </div>
        }
    }
}

templ ShowImages(result any, isHtmx bool) {
    if isHtmx {
        @tab.Images()
    } else {
        @layout.Base() {
            <div class="page-wrapper">
                @component.ResultHeader()
                <div id="results" class="content-container py-6">
                    @tab.Images()
                </div>
            </div>
        }
    }
}
