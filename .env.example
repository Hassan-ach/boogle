# Boogle - Environment Configuration Example
# Copy this file to .env, then replace every "change-me-*" value with a real
# secret. These names must match the copies in each service's .env.

# ============================================
# PostgreSQL (all services)
# ============================================
PG_HOST=psql
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=change-me-postgres
PG_DBNAME=se

# Connection pooling (spider)
PG_MAX_OPEN_CONNS=20
PG_MAX_IDLE_CONNS=20
PG_MAX_CONN_LIFETIME=0
PG_BATCH_SIZE=30

# ============================================
# Redis (spider)
# ============================================
REDIS_ADDR=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=1
REDIS_DELAY=5
REDIS_MAX_RETRY=10

# ============================================
# RabbitMQ (broker container + every service)
# ============================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# One queue name, read by both the spider (producer) and indexer (consumer).
RABBITMQ_QUEUE=indexer.jobs
RABBITMQ_CONFIRMATION_QUEUE=indexer.confirmations

# ============================================
# Spider
# ============================================
MAX_CRAWLERS=20
HTTP_TIMEOUT=60
CRAWLER_TIMEOUT=60
MAX_CONCURRENT_FETCH=200
CRAWLER_DELAY=200
LOGS_PATH=./logs/spider.log

# ============================================
# Indexer
# ============================================
DATABASE_URL=postgres://admin:change-me-postgres@psql:5432/se
PG_MAX_CONNECTIONS=10
PG_MIN_CONNECTIONS=2
ACQUIRE_TIMEOUT_SECONDS=5
WORD_BATCH_SIZE=1000
PAGE_WORD_BATCH_SIZE=500
SWEEP_INTERVAL_SECONDS=300
SWEEP_GRACE_SECONDS=600
SWEEP_BATCH_SIZE=500
MAX_INDEX_ATTEMPTS=3
MAX_RETRIES=3
LOG_PATH=./logs/indexer.log

# ============================================
# Engine
# ============================================
PAGE_SIZE=20
RANKER_MAX_RESULTS=100
RANKER_WEIGHT_TF=0.5

# ============================================
# Ranking
# ============================================
RANKING_CONFIRMATION_THRESHOLD=100
RANKING_RUN_ON_STARTUP=true
